                    "editorMode": "code", "format": "table", "rawQuery": true,
                    "rawSql": "SELECT\n  ROUND(\n    (1 - COUNT(fa.alert_id) * 1.0\n         / NULLIF(COUNT(DISTINCT fe.execution_id), 0)\n    ) * 100, 1\n  ) AS \"SLA respecté (%)\"\nFROM fact_execution fe\nJOIN dim_interface di USING (interface_id)\nJOIN dim_client dc USING (client_id)\nLEFT JOIN fact_alert fa\n  ON fa.execution_id = fe.execution_id\n  AND fa.alert_type IN ('SLA_BREACH', 'TIMEOUT')\nWHERE dc.nom = '${client_id}'\n  AND fe.env_id = 3\n  AND fe.start_datetime >= NOW() - INTERVAL '30 days';",
                    "refId": "A",
                    "sql": { "columns": [{ "parameters": [], "type": "function" }], "groupBy": [{ "property": { "type": "string" }, "type": "groupBy" }], "limit": 50 }
