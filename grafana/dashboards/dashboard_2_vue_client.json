                    "rawSql": "SELECT \n  fe.execution_id,\n  di.code AS \"Interface\",\n  fe.source_execution_ref AS \"Référence\",\n  di.libelle AS \"Libellé interface\",\n  fe.status AS \"Statut\",\n  fe.start_datetime AS \"Début\",\n  fe.end_datetime AS \"Fin\",\n  fe.duration_seconds AS \"Durée (sec)\"\nFROM fact_execution fe\nJOIN dim_interface di USING (interface_id)\nJOIN dim_client dc USING (client_id)\nWHERE dc.nom = '${client_id}'\n  AND fe.env_id = 3\nORDER BY fe.start_datetime DESC\nLIMIT 20;",
