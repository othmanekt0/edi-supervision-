                    "rawSql": "SELECT \n  fes.step_name AS \"Étape\",\n  fes.step_type AS \"Type\",\n  fes.status AS \"Statut\",\n  fes.start_datetime AS \"Début\",\n  fes.end_datetime AS \"Fin\",\n  fes.error_message AS \"Erreur\"\nFROM fact_execution_step fes\nJOIN fact_execution fe USING (execution_id)\nJOIN dim_interface di USING (interface_id)\nJOIN dim_client dc USING (client_id)\nWHERE dc.nom = '${client_id}'\n  AND fe.env_id = 3\nORDER BY fes.step_id DESC\nLIMIT 50;",
