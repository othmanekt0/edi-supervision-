                    "rawSql": "SELECT\n  ROUND(\n    COUNT(*) FILTER (WHERE fe.status = 'SUCCESS') * 100.0\n    / NULLIF(COUNT(*) FILTER (WHERE fe.status IN ('SUCCESS','FAILURE','WARNING','KILLED')), 0),\n  1) AS \"Taux de succès (%)\"\nFROM fact_execution fe\nJOIN dim_interface di USING (interface_id)\nJOIN dim_client dc USING (client_id)\nWHERE dc.nom = '${client_id}'\n  AND fe.env_id = 3\n  AND fe.start_datetime >= NOW() - INTERVAL '30 days';",
