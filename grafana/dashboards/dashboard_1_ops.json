                    "editorMode": "code", "format": "table", "rawQuery": true,
                    "rawSql": "SELECT \n  fa.alert_type AS \"Type\",\n  fa.severity AS \"Sévérité\",\n  di.libelle AS \"Interface\",\n  fa.message AS \"Message\",\n  fa.triggered_at AS \"Déclenchée le\"\nFROM fact_alert fa\nJOIN fact_execution fe USING (execution_id)\nLEFT JOIN dim_interface di ON fe.interface_id = di.interface_id\nWHERE fa.resolved_at IS NULL\nORDER BY\n  CASE fa.severity WHEN 'CRITICAL' THEN 1 WHEN 'HIGH' THEN 2 WHEN 'MEDIUM' THEN 3 ELSE 4 END,\n  fa.triggered_at DESC\nLIMIT 20;",
