                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  i.code                          AS \"Interface\",\n  i.libelle                       AS \"Libelle\",\n  COUNT(*)                        AS \"Executions Failed\",\n  MAX(e.start_datetime)           AS \"Derniere erreur\",\n  MIN(e.error_message)            AS \"Derniere erreur msg\"\nFROM fact_execution e\nJOIN dim_interface i ON i.interface_id = e.interface_id\nWHERE UPPER(e.status) IN ('FAILED', 'FAILURE')\n  AND e.start_datetime >= $__timeFrom()\n  AND e.start_datetime <= $__timeTo()\nGROUP BY i.interface_id, i.code, i.libelle\nORDER BY \"Executions Failed\" DESC",
