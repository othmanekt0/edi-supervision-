          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cfqvza7ykhudce"
                      },
                      "spec": {
                        "format": "table",
                        "rawSql": "SELECT\n  '$interface_code' AS \"Interface\",\n  COUNT(*) AS \"Executions Failed\"\nFROM fact_execution e\nJOIN dim_interface i ON i.interface_id = e.interface_id\nWHERE i.code = '$interface_code'\n  AND UPPER(e.status) IN ('FAILED', 'FAILURE')\n  AND e.start_datetime >= $__timeFrom()\n  AND e.start_datetime <= $__timeTo()"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
