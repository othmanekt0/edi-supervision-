                      "version": "v0",
                      "datasource": {
                        "name": "cfqvza7ykhudce"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  e.execution_id                                      AS \"execution_id\",\n  e.source_execution_ref                              AS \"Ref Execution\",\n  e.status                                            AS \"Statut\",\n  e.start_datetime                                    AS \"Début\",\n  e.end_datetime                                      AS \"Fin\",\n  e.duration_seconds                                  AS \"Durée (s)\",\n  COALESCE(env.nom, '')                               AS \"Environnement\",\n  e.server_name                                       AS \"Serveur\",\n  e.retry_count                                       AS \"Retry\",\n  e.error_message                                     AS \"Erreur\"\nFROM fact_execution e\nJOIN dim_interface i  ON i.interface_id = e.interface_id\nLEFT JOIN dim_environment env ON env.env_id = e.env_id\nWHERE i.code = '$interface_code'\n  AND UPPER(e.status) IN ('FAILED', 'FAILURE')\n  AND e.start_datetime >= $__timeFrom()\n  AND e.start_datetime <= $__timeTo()\nORDER BY e.start_datetime DESC",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
