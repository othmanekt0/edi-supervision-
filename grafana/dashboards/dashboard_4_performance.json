            "pluginVersion": "13.1.0",
            "targets": [{ "dataset": "supervision", "datasource": { "type": "grafana-postgresql-datasource", "uid": "bfssjum1dvoqob" }, "editorMode": "code", "format": "table", "rawQuery": true, "rawSql": "SELECT\n  di.libelle AS \"Interface\",\n  ROUND(AVG(fe.duration_seconds)) AS \"Durée moy (sec)\",\n  ROUND(PERCENTILE_CONT(0.95) WITHIN GROUP (ORDER BY fe.duration_seconds)) AS \"P95 (sec)\"\nFROM fact_execution fe\nJOIN dim_interface di USING (interface_id)\nWHERE fe.env_id = 3\n  AND fe.status NOT IN ('RUNNING')\n  AND fe.duration_seconds > 0\n  AND fe.start_datetime >= NOW() - INTERVAL '30 days'\nGROUP BY di.libelle\nORDER BY \"P95 (sec)\" DESC;", "refId": "A", "sql": { "columns": [{ "parameters": [], "type": "function" }], "groupBy": [{ "property": { "type": "string" }, "type": "groupBy" }], "limit": 50 } }],
